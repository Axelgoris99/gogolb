---
import { render } from 'astro:content';
import { getPublishedPosts } from '../../utils/posts';
import PostLayout from '../../layouts/PostLayout.astro';

// Generate static paths for all posts
export async function getStaticPaths() {
  const sortedPosts = await getPublishedPosts();
  const link = (post?: (typeof sortedPosts)[number]) =>
    post ? { url: `/posts/${post.id}/`, title: post.data.title } : null;

  // Newest first, so the newer post comes before this one.
  return sortedPosts.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, newer: link(sortedPosts[index - 1]), older: link(sortedPosts[index + 1]) },
  }));
}

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
---

<PostLayout frontmatter={entry.data} newer={newer} older={older}>
  <Content />
</PostLayout>
