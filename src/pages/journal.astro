---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListWithThumbnails from '../components/PostListWithThumbnails.astro';
import { getPublishedPosts } from '../utils/posts';

const sortedPosts = await getPublishedPosts();

// Format posts for the PostList component
const posts = sortedPosts.map(post => ({
  ...post,
  url: `/posts/${post.id}`,
  frontmatter: post.data
}));
---

<BaseLayout title="Journal" description="Every post on GoGolb: homelab, self-hosting, Proxmox, NixOS and the bugs I hit along the way.">
  <div class="max-w-3xl mx-auto">
    <header class="mb-12 text-center" transition:animate="fade">
      <h1 class="text-5xl mb-4">Journal</h1>
      <p class="text-xl text-muted-foreground">
        Explore my latest thoughts, ideas, and stories
      </p>
    </header>

    <div transition:animate="fade">
      <PostListWithThumbnails posts={posts} showTags={true} title="All Posts" />
    </div>
  </div>
</BaseLayout>
